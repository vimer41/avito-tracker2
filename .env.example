# Токен вашего Telegram бота от @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram ID администраторов (обязательно задать в продакшене)
ADMIN_IDS=986832959

# Актуальные интервалы сканирования и тарифов (секунды)
CHECK_INTERVAL=20
SCAN_INTERVAL_MIN=15
SCAN_INTERVAL_MAX=20
TARIFF_INTERVAL_LITE=40
TARIFF_INTERVAL_STANDART=30
TARIFF_INTERVAL_PRO=20
TARIFF_INTERVAL_TRIAL=20

# Лимит радаров администратора (по тарифам: Базовый 1, Средний 2, Полный 4)
MAX_SEARCHES_PER_USER=20

# Воркеры сканирования и процессы антибота
MAX_CONCURRENT_WORKERS=4
SCAN_MAX_WORKERS=32
SCAN_PROXY_ATTEMPTS=3
CHALLENGE_WORKERS=3
AVITO_CACHE_BUST_MODE=off

# Telegram Outbox & Rate Limits
OUTBOX_WORKERS=8
TELEGRAM_GLOBAL_RATE=25.0
TELEGRAM_CHAT_INTERVAL=1.0
NOTIFICATION_MAX_AGE=1800

# Догон пропущенных лотов после подтвержденного простоя (Полный / Admin)
CATCHUP_MAX_AGE_MINUTES=30
CATCHUP_MAX_ITEMS=10
BROAD_RADAR_MAX_PAGES=3

# Пул статических прокси (дополнительно управляются через /proxy в боте)
PROXY_POOL_FILE=proxies.txt
PROXY_URL=
PROXY_RATE_LIMIT=1.0
PROXY_MIN_RATE=0.25
PROXY_MAX_IN_FLIGHT=1
PROXY_QUARANTINE_BASE=180
PROXY_QUARANTINE_MAX=900

# Параметры HTTP-запросов и скрапера
AVITO_FETCH_TIMEOUT=45
AVITO_MAX_REQUESTS_PER_FETCH=8
AVITO_MAX_PAGES_PER_SCAN=2
ALLOW_DIRECT_AVITO=0

# Планировщик и кэш источников
SCAN_MAX_INTERVAL=120
SCAN_BUDGET_UTILIZATION=0.8
SCAN_STARTUP_SPREAD=15
INITIAL_SNAPSHOT_TTL=25

# Пул чтения SQLite
DB_READ_POOL_SIZE=4

# Разовая подписка на 30 дней, без автопродления. Telegram Stars (XTR) + рублёвый эквайринг Platega.
STARS_PAYMENTS_ENABLED=0
STARS_PRICE_BASIC=199
STARS_PRICE_MEDIUM=449
STARS_PRICE_FULL=899
PRICE_RUB_BASIC=349
PRICE_RUB_MEDIUM=790
PRICE_RUB_FULL=1590
PERIOD_3M_DISCOUNT=10
RUB_TEST_ENABLED=0

# Оплата рублями через Platega (СБП, карта, криптовалюта). Ключи — в кабинете Platega, раздел «Настройки».
# Без обоих ключей кнопки оплаты рублями только сообщают, что оплата скоро появится.
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# Вебхук Platega (необязательно): локальный порт за обратным прокси с HTTPS. 0 — выключен,
# тогда бот проверяет статусы платежей сам, по расписанию.
PLATEGA_CALLBACK_PORT=0
# PLATEGA_CALLBACK_HOST=127.0.0.1
# PLATEGA_CALLBACK_PATH=platega/callback
